# ===== FunPay =====
# golden_key — cookie твоего аккаунта FunPay.
# Как получить: зайди на funpay.com → F12 (DevTools) → вкладка Application/Хранилище →
# Cookies → https://funpay.com → скопируй значение cookie "golden_key" и вставь сюда.
GOLDEN_KEY=

# ===== Telegram =====
# Токен бота от @BotFather (вида 123456:AA...)
BOT_TOKEN=

# Твой Telegram ID (узнать: напиши боту @userinfobot).
# Уведомления будет получать только этот пользователь.
TG_USER_ID=

# ===== Необязательное =====
# Задержка между опросами FunPay (сек). Меньше 4 ставить не стоит.
REQUESTS_DELAY=5
# Свой User-Agent (обычно менять не нужно).
USER_AGENT=

# MTProto-прокси — НЕ нужен VPN!
# Формат: host:port:secret, несколько через ";"
# Пусто = бот подключается к Telegram напрямую (для большинства работает).
# Если ты в РФ и Telegram не открывается — поставь любой публичный MTProto-прокси
# или локальный TgWsProxy (бот сам подхватит его конфиг, если он запущен на 127.0.0.1:1443).
TG_MTPROXY=

# ===== Автоответы покупателю =====
# Отправляются САМИ только когда покупатель подтвердил заказ / оставил отзыв.
# Пустая строка = выключить соответствующий автоответ.
AUTO_REPLY_CONFIRM=Спасибо, что подтвердили заказ! Если не сложно, оставьте отзыв — очень поможет
AUTO_REPLY_REVIEW=Огромное спасибо за отзыв! Поставлю свечку за вас

# Напоминание покупателю, если заказ долго не подтверждён (раз в N часов).
# Пустой текст = выключить напоминания.
REMINDER_TEXT=Привет, незабудь подтвердить заказ и по возможности оставить отзыв❤️
REMINDER_INTERVAL_HOURS=4

# Заявка в поддержку FunPay (support.funpay.com), если заказ не подтверждён
# дольше этого срока. Проверка каждые SUPPORT_CHECK_MINUTES минут — тикет уходит
# сразу, как только заказ перевалил за срок. Лимит FunPay: заявка на подтверждение
# — 1 раз в сутки, поэтому за проверку берутся все созревшие заказы одним тикетом.
# SUPPORT_TEXT: {order} — номер заказа, {buyer} — ник покупателя, {hours} — срок.
# Пустой текст = выключить заявки.
SUPPORT_CONFIRM_HOURS=24
SUPPORT_CHECK_MINUTES=10
SUPPORT_TEXT=Здравствуйте! Заказ #{order} (покупатель {buyer}) оплачен, но не подтверждён уже больше {hours:.0f} ч. Покупатель не отвечает на напоминания в чате. Прошу подтвердить заказ вручную. Спасибо!

# Свои api_id/api_hash из my.telegram.org (необязательно, есть рабочие по умолчанию).
API_ID=
API_HASH=

# Пароль доступа к боту для чужих (необязательно). Пусто = доступ только у владельца.
# Чужой пишет боту этот пароль — получает доступ к меню (НО не к золотому ключу!).
# НИКОГДА не указывай здесь golden_key.
BOT_PASSWORD=
